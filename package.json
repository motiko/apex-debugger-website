    "dev": "run-p serve compile:css"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.3.0",
    "postcss-cli": "^12.0.0",
    "serve": "^14.2.4",
    "tailwindcss": "^2.1.2"
  },
  "overrides": {
    "compression": "^1.8.2",
    "postcss-selector-parser": "^7.1.6"
  }
}
