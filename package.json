{
  "scripts": {
    "build": "tailwindcss -i styles.css -o public/compiled.css --minify",
    "serve": "serve public -p 3000",
    "compile:css": "tailwindcss -i styles.css -o public/compiled.css --watch=always",
    "dev": "run-p serve compile:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "compression": "^1.8.2",
    "@parcel/watcher": "^2.6.0"
  }
}
